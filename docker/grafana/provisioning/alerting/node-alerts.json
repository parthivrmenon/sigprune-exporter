{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "NodeExporterAlerts",
      "folder": "Infrastructure",
      "interval": "1m",
      "rules": [
        {
          "uid": "node_exporter_host_down",
          "title": "Host Down",
          "condition": "B",
          "for": "5m",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "model": {
                "expr": "up{job=\"node\"} == 0",
                "hide": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "model": {
                "conditions": [
                  {
                    "evaluator": { "params": [0], "type": "gt" },
                    "operator": { "type": "and" },
                    "query": { "params": ["A"] },
                    "reducer": { "params": [], "type": "last" },
                    "type": "query"
                  }
                ],
                "refId": "B",
                "type": "classic_conditions"
              }
            }
          ],
          "annotations": {
            "summary": "Instance {{ $labels.instance }} is down",
            "description": "Node exporter has been unreachable for more than 5 minutes."
          },
          "labels": { "severity": "critical" }
        },
        {
          "uid": "node_exporter_high_cpu",
          "title": "High CPU Usage",
          "condition": "C",
          "for": "5m",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "model": {
                "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
                "refId": "A"
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "model": {
                "expression": "A",
                "type": "threshold",
                "conditions": [
                  {
                    "evaluator": { "params": [85], "type": "gt" },
                    "unloadEvaluator": { "params": [80], "type": "lt" }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "annotations": {
            "summary": "High CPU utilization on {{ $labels.instance }}",
            "description": "CPU usage is currently at {{ $values.C.Value }}%."
          },
          "labels": { "severity": "warning" }
        },
        {
          "uid": "node_exporter_disk_filling",
          "title": "Disk Space Running Low",
          "condition": "C",
          "for": "15m",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 600, "to": 0 },
              "model": {
                "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\"} * 100) / node_filesystem_size_bytes{mountpoint=\"/\"})",
                "refId": "A"
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": { "from": 600, "to": 0 },
              "model": {
                "expression": "A",
                "type": "threshold",
                "conditions": [
                  {
                    "evaluator": { "params": [90], "type": "gt" }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "annotations": {
            "summary": "Root partition full on {{ $labels.instance }}",
            "description": "Disk utilization has breached 90% (Current: {{ $values.C.Value }}%)."
          },
          "labels": { "severity": "critical" }
        },
        {
          "uid": "node_exporter_high_memory",
          "title": "High Memory Usage",
          "condition": "C",
          "for": "5m",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "model": {
                "expr": "100 * (1 - ((node_memory_MemFree_bytes + node_memory_Buffers_bytes + node_memory_Cached_bytes) / node_memory_MemTotal_bytes))",
                "refId": "A"
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "model": {
                "expression": "A",
                "type": "threshold",
                "conditions": [
                  {
                    "evaluator": { "params": [85], "type": "gt" }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "annotations": {
            "summary": "Memory saturation on {{ $labels.instance }}",
            "description": "System memory utilization is high: {{ $values.C.Value }}%."
          },
          "labels": { "severity": "warning" }
        }
      ]
    }
  ]
}
