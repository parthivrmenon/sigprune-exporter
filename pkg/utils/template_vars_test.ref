package utils

import (
	"reflect"
	"sort"
	"testing"
)

// sameSet compares ignoring order, and treats a nil slice and an empty slice as
// equal. Callers collect these into a set, so neither ordering nor nil-ness is
// part of the contract.
func sameSet(got, want []string) bool {
	g := append([]string(nil), got...)
	w := append([]string(nil), want...)
	sort.Strings(g)
	sort.Strings(w)
	if len(g) == 0 && len(w) == 0 {
		return true
	}
	return reflect.DeepEqual(g, w)
}

// The queries below are real: every label_values and query_result case is taken
// from a dashboard published on grafana.com (1860 Node Exporter Full, 315 and
// 1621 Kubernetes cluster monitoring, 893 Docker and system monitoring, 11074
// Node Exporter Dashboard EN, 3662 Prometheus 2.0 Overview).
func TestExtractMetricsAndLabelsFromTemplateQuery(t *testing.T) {
	tests := []struct {
		name        string
		query       string
		wantMetrics []string
		wantLabels  []string
	}{
		// --- Form 1: label_values(<selector>, <label>) ---





		// --- Form 2: label_values(<label>) ---

		{
			name:        "one arg, underscores do not make it a metric",
			query:       `label_values(container_group)`,
			wantMetrics: nil,
			wantLabels:  []string{"container_group"},
		},

		// --- Form 3: query_result(<promql>) ---



		// --- anything else yields nothing ---
		{
			name:        "metrics() is a regex over names, not a reference",
			query:       `metrics(node_)`,
			wantMetrics: nil,
			wantLabels:  nil,
		},
		{
			name:        "label_names() names nothing in particular",
			query:       `label_names()`,
			wantMetrics: nil,
			wantLabels:  nil,
		},
		{
			// A custom variable's value, which the caller should have filtered
			// out by Type - belt and braces.
			name:        "custom variable values",
			query:       `5,10,20,50`,
			wantMetrics: nil,
			wantLabels:  nil,
		},
		{
			// A datasource variable's value. This one parses as a valid metric
			// selector, so without the wrapper check it would be recorded as a
			// used metric named "prometheus".
			name:        "datasource variable value",
			query:       `prometheus`,
			wantMetrics: nil,
			wantLabels:  nil,
		},
		{
			name:        "empty",
			query:       ``,
			wantMetrics: nil,
			wantLabels:  nil,
		},
		{
			name:        "unterminated wrapper does not panic",
			query:       `label_values(node_uname_info, job`,
			wantMetrics: nil,
			wantLabels:  nil,
		},
		{
			name:        "empty argument list",
			query:       `label_values()`,
			wantMetrics: nil,
			wantLabels:  nil,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			metrics, labels := ExtractMetricsAndLabelsFromTemplateQuery(tt.query)
			if !sameSet(metrics, tt.wantMetrics) {
				t.Errorf("metrics: got %v, want %v", metrics, tt.wantMetrics)
			}
			if !sameSet(labels, tt.wantLabels) {
				t.Errorf("labels: got %v, want %v", labels, tt.wantLabels)
			}
		})
	}
}
